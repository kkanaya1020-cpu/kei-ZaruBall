#include "ZaruBall.dtsi"
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/* evt-type / x-input-code / y-input-code 用 */
#include <zephyr/dt-bindings/input/input-event-codes.h>

&xiao_serial { status = "disabled"; };

/* matrix transformでのピン数オフセット */
&default_transform { /* Offset of 7 because the left side has 2 columns */
    col-offset = <12>;
    row-offset = <12>;
};

&kscan0 {
    /* マトリクス行列 */
    gpios = <&xiao_d 0 GPIO_ACTIVE_HIGH>, /* M1 */
            <&xiao_d 1 GPIO_ACTIVE_HIGH>, /* M2 */
            <&xiao_d 2 GPIO_ACTIVE_HIGH>, /* M3 */
            <&xiao_d 3 GPIO_ACTIVE_HIGH>, /* M4 */
            <&xiao_d 4 GPIO_ACTIVE_HIGH>, /* M5 */
            <&xiao_d 5 GPIO_ACTIVE_HIGH>; /* M6 */

    /* 割り込みピン */
    interrupt-gpios = <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; /* IGPIO */
};

/* pmw-3610-driver（古いブランチ:pointers-move-scroll）------------------------ */
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,  /* SCLK */
                    <NRF_PSEL(SPIM_MOSI, 1, 13)>, /* SDIO */
                    <NRF_PSEL(SPIM_MISO, 1, 13)>; /* SDIO */
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 13)>,
                    <NRF_PSEL(SPIM_MISO, 1, 13)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio1 14 GPIO_ACTIVE_LOW>; /* CS */

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio1 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* MOTION */

        /* 体感（速度/スクロール量）を戻すための要 */
        cpi = <1000>;

        /* ===== required (pixart,pmw3610.yml) =====
         * zip_xy_transform / zip_xy_to_scroll_mapper 等が想定する
         * 「相対移動（REL）」として出すため、REL系で揃える。
         */
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;

        /*   optional features   */
        /* snipe-layers = <1 2>; */
        /* automouse-layer = <1>; */ /* ← 使わないので残してもコメントのまま */
        /* force-awake; */            /* 入力の“抜け”を感じるなら有効化（消費↑） */
        /* force-awake-4ms-mode; */   /* 有線等で高頻度にしたい場合のみ */
    };
};

/* ---- Auto Mouse Layer: 30s ---- */
 / {
    zip_temp_layer_long: zip_temp_layer_long {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;

        /* クリック系の“位置”は即解除させない（仮の番号） */
        excluded-positions = <20 27 33 34 35 36 38 45 46 47 48>;
        require-prior-idle-ms = <250>;
    };
};

 / {
  trackball_listener {
    compatible = "zmk,input-listener";
    device = <&trackball>;

    /* 60s のみ（250msはマクロ側で処理） */
    input-processors = <
        &zip_temp_layer_long  1 60000
    >;

    /* --- カーソル（マウスレイヤー）：
     * マウスレイヤー時だけ縦横が逆になる症状を補正するため、
     * カーソル側にも XY_SWAP を適用する。
     */
    cursor_mouse {
        layers = <1>; /* MOUSE layer */
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP)
        >;
    };

    /* --- 縦スクロール：Xだけ縦ホイール（右=下／左=上）, Y 無効 --- */
    scroller_v {
        layers = <5>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP)
            &zip_x_scaler 0 1
            /* 初動/量が極小になっていたため、ここは現状維持（必要なら 1 1 へ） */
            &zip_y_scaler 1 1
            &zip_xy_to_scroll_mapper
            /* 量が小さすぎる原因が 1/8 * 1/12 (=1/96) なので、ここを強める */
            &zip_scroll_scaler 1 8
        >;
    };

    /* --- 横スクロール：X を横ホイール, Y 無効 --- */
    scroller_h {
        layers = <6>;
        /* Y は未使用（ダミー） */
        input-processors = <
            &zip_y_scaler 0 1
            /* 初動/量が極小になっていたため、ここは現状維持（必要なら 1 1 へ） */
            &zip_x_scaler 1 1
            &zip_xy_to_scroll_mapper
            /* 方向は現状維持：反転はそのまま */
            &zip_scroll_transform (INPUT_TRANSFORM_X_INVERT)
            /* 量が小さすぎる原因が 1/8 * 1/12 (=1/96) なので、ここを強める */
            &zip_scroll_scaler 1 8
        >;
    };
  };
};
