//#include <dt-bindings/zmk/mouse.h>

#include <behaviors/rgbled_widget.dtsi>
#include <behaviors/naginata.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE     0
#define MOUSE    1
#define LOWER    2
#define RAISE    3
#define NUM      4
#define SCR_V    5      // ← scr_v_layer
#define SCR_H    6      // ← scr_h_layer
#define ADJUST   7

// スクロール量の設定
// #define ZMK_POINTING_DEFAULT_SCRL_VAL 100

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <LOWER RAISE>;   // ← 数値の代わりにマクロでOK
            then-layer = <ADJUST>;       // ← 4 → ADJUST(=7)
        };
    };
};

/ {
    behaviors {
        // スクロール用のbehaviorの設定

        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        // 方向が逆だと思ったら、下の別定義を有効化して置き換えればOK
        // scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
        //     compatible = "zmk,behavior-sensor-rotate";
        //     #sensor-binding-cells = <0>;
        //     bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>; // ↑と↓を反転
        //     tap-ms = <20>;
        // };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo RAISE>, <&mo MOUSE>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo RAISE>, <&mo MOUSE>;
        };

        // Customed Hold-Tap for SandS

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <500>;
            quick-tap-ms = <500>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };

        td_click: td_click {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mkp_exit_AML LCLK>, <&mkp_dblclick_exit_AML LCLK>;

            label = "TD_CLICK";
        };

        td_sh: td_sh {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SH";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(NUMBER_5))>, <&kp LG(LS(NUMBER_4))>;
        };

        td_window: td_window {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_WINDOW";
            #binding-cells = <0>;
            bindings = <&kp LA(UP_ARROW)>, <&kp LG(LA(UP_ARROW))>;
        };

        td_lang1: td_lang1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LANG1";
            #binding-cells = <0>;
            bindings = <&mt RIGHT_GUI LANG1>, <&kp RG(RIGHT_ARROW)>;

            tapping-term-ms = <125>;
        };

        td_lang2: td_lang2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LANG2";
            #binding-cells = <0>;
            bindings = <&mt LEFT_ALT LANG2>, <&kp RG(LEFT_ARROW)>;

            tapping-term-ms = <125>;
        };

        td_space: td_space {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SPACE";
            #binding-cells = <0>;
            bindings = <&lt 5 SPACE>, <&kp SPACE>;

            tapping-term-ms = <125>;
        };

        td_bs: td_bs {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BS";
            #binding-cells = <0>;
            bindings = <&mt LEFT_SHIFT BACKSPACE>, <&kp BACKSPACE>;

            tapping-term-ms = <125>;
        };

        td_enter: td_enter {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ENTER";
            #binding-cells = <0>;
            bindings = <&mt RIGHT_SHIFT ENTER>, <&kp ENTER>;

            tapping-term-ms = <125>;
        };

        td_app: td_app {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_APP";
            #binding-cells = <0>;
            bindings = <&lt 6 LA(S)>, <&kp LA(N)>;

            tapping-term-ms = <125>;
        };

        td_mute: td_mute {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MUTE";
            #binding-cells = <0>;
            bindings = <&kp RG(RS(T))>, <&kp C_MUTE>;
        };

        td_chrome: td_chrome {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_CHROME";
            #binding-cells = <0>;
            bindings = <&kp RS(RG(N))>, <&kp LG(LA(I))>;
        };
    };
};

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog MOUSE &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        // When LCLK pressed, exit AML after 250ms

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_wait_time 120>,
                <&macro_tap>,
                <&to 0>;

            label = "MKP_EXIT_AML";
        };

        mkp_dblclick_exit_AML: mkp_dblclick_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;

            /* 想定：MOUSEレイヤー=1。必要なら &tog の引数はMOUSEに置換可 */

            bindings =
                <&macro_tap>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_wait_time 40>,
                <&macro_tap>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_wait_time 120>,
                <&macro_tap>,
                <&to 0>;

            label = "MKP_DBLCLICK_EXIT_AML";
        };

        cmd_click: cmd_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_wait_time 25>,
                <&mkp LCLK>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_wait_time 5>,
                <&mkp LCLK>,
                <&macro_wait_time 15>,
                <&kp LEFT_GUI>,
                <&macro_wait_time 120>,
                <&macro_tap>,
                <&to 0>;

            label = "CMD_CLICK";
        };

        alt_click: alt_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 25>,
                <&mkp LCLK>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_wait_time 5>,
                <&mkp LCLK>,
                <&macro_wait_time 15>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 120>,
                <&macro_tap>,
                <&to 0>;

            label = "ALT_CLICK";
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&inc_dec_kp LA(LEFT_ARROW) LA(RIGHT_ARROW)>;
            bindings = <
&kp ESC           &kp N1      &kp N2  &kp N3       &kp N4       &kp N5                                          &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                             &kp NUMBER_6         &kp N7  &kp N8     &kp N9   &kp N0     &lt 4 C_MUTE
&kp TAB           &kp Q       &kp W   &kp E        &kp R        &kp T                                           &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                           &kp Y                &kp U   &kp I      &kp O    &kp P      &kp EQUAL
&kp LEFT_CONTROL  &kp A       &kp S   &kp D        &kp F        &kp G               &td_sh                      &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &kp UP_ARROW           &kp H                &kp J   &kp K      &kp L    &kp MINUS  &kp SEMICOLON
&kp LEFT_ARROW    &kp Z       &kp X   &kp C        &kp V        &kp B               &td_window                  &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp DOWN_ARROW         &kp N                &kp M   &kp COMMA  &kp DOT  &kp FSLH   &kp RIGHT_ARROW
&lt 2 LG(C)       &kp C_MUTE          &lt 6 LA(S)  &lt 5 SPACE  &mt LEFT_ALT LANG2  &mt LEFT_SHIFT BACKSPACE                                                            &mt RIGHT_SHIFT ENTER  &mt RIGHT_GUI LANG1                                         &lt 3 RG(V)
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &trans      &trans      &trans              &trans     &trans            &trans  &trans  &trans  &trans            &trans  &trans     &trans              &trans      &trans      &trans
&trans  &trans      &trans      &trans              &mkp LCLK  &trans            &trans  &trans  &trans  &trans            &trans  &mkp LCLK  &trans              &trans      &trans      &trans
&trans  &alt_click  &cmd_click  &mkp_exit_AML RCLK  &td_click  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &td_click  &mkp_exit_AML RCLK  &cmd_click  &alt_click  &trans
&trans  &trans      &trans      &trans              &trans     &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans     &trans              &trans      &trans      &trans
&trans  &trans                  &trans              &trans     &trans  &trans                                      &trans  &trans                                                         &trans
            >;
        };

        Fn_layer {
            display-name = "Fn";
            sensor-bindings = <&inc_dec_kp F14 F15>;
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans                               &trans  &trans  &trans  &trans               &trans               &trans              &trans               &trans         &trans     &trans
&trans  &trans  &trans  &trans  &trans     &trans                               &trans  &trans  &trans  &trans               &trans               &kp LG(LEFT_ARROW)  &kp LG(RIGHT_ARROW)  &td_chrome     &trans     &trans
&trans  &trans  &trans  &trans  &trans     &trans              &trans           &trans  &trans  &trans  &trans    &trans     &trans               &kp LS(LC(TAB))     &kp LC(TAB)          &kp RS(RG(A))  &trans     &trans
&trans  &trans  &trans  &trans  &trans     &trans              &trans           &trans  &trans  &trans  &trans    &trans     &trans               &kp LA(LEFT_ARROW)  &kp LA(RIGHT_ARROW)  &td_window     &kp RA(R)  &trans
&trans  &trans          &trans  &kp SPACE  &kp LG(LEFT_ARROW)  &kp BACKSPACE                                      &kp ENTER  &kp RG(RIGHT_ARROW)                                                                     &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            sensor-bindings = <&inc_dec_kp LC(LEFT_ARROW) LC(RIGHT_ARROW)>;
            bindings = <
&trans  &kp LG(LEFT_ARROW)      &kp LG(UP_ARROW)      &kp LG(DOWN_ARROW)      &kp LG(RIGHT_ARROW)      &none                                   &trans  &trans  &trans  &trans               &none                &none      &none      &none  &none  &none
&trans  &kp LS(LEFT)            &kp LS(UP_ARROW)      &kp LS(DOWN_ARROW)      &kp LS(RIGHT)            &none                                   &trans  &trans  &trans  &trans               &none                &none      &none      &none  &none  &none
&trans  &kp LEFT_ARROW          &kp UP_ARROW          &kp DOWN_ARROW          &kp RIGHT_ARROW          &none               &none               &trans  &trans  &trans  &trans    &none      &none                &mkp LCLK  &mkp RCLK  &none  &none  &none
&trans  &kp LS(LG(LEFT_ARROW))  &kp LS(LG(UP_ARROW))  &kp LS(LG(DOWN_ARROW))  &kp LS(LG(RIGHT_ARROW))  &none               &kp RC(UP_ARROW)    &trans  &trans  &trans  &trans    &none      &none                &kp HOME   &kp END    &none  &none  &none
&trans  &none                                         &trans                  &kp SPACE                &kp LG(LEFT_ARROW)  &kp BACKSPACE                                         &kp ENTER  &kp RG(RIGHT_ARROW)                                      &trans
            >;
        };

        number_layer {
            display-name = "number";
            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
            bindings = <
&trans  &none       &none  &none   &none   &none             &trans  &trans  &trans  &trans              &none         &none            &none            &none            &none            &none
&trans  &none       &none  &none   &none   &none             &trans  &trans  &trans  &trans              &kp PLUS      &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_4  &kp KP_NUMBER_5
&trans  &none       &none  &none   &none   &none   &none     &trans  &trans  &trans  &trans    &kp HOME  &kp KP_MINUS  &kp KP_NUMBER_6  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMBER_0
&trans  &none       &none  &none   &none   &none   &none     &trans  &trans  &trans  &trans    &kp END   &kp ASTERISK  &kp SLASH        &kp COMMA        &kp PERIOD       &none            &none
&trans  &kp C_MUTE         &trans  &trans  &trans  &trans                                      &trans    &kp EQUAL                                                                         &trans
            >;
        };

        scr_v_layer {
            display-name = "SCR_V";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans                   &trans  &trans                &trans                 &trans       &trans             &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans                   &trans  &kp RS(LEFT_BRACKET)  &kp RS(RIGHT_BRACKET)  &kp RS(SQT)  &kp RS(BACKSLASH)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans         &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SQT      &kp RS(GRAVE)      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans         &trans  &trans                &kp GRAVE              &trans       &kp BACKSLASH      &trans
&trans  &trans          &trans  &trans  &trans  &trans                                      &kp RG(ENTER)  &trans                                                                               &trans
            >;

            sensor-bindings = <&inc_dec_kp F14 F15>;
        };

        scr_h_layer {
            display-name = "SCR_H";
            bindings = <
&trans  &none           &none         &none           &none            &none                                &trans  &trans  &trans  &trans               &bt BT_SEL 0         &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR_ALL
&trans  &none           &none         &none           &none            &none                                &trans  &trans  &trans  &trans               &none                &kp F1        &kp F2        &kp F3        &kp F4        &kp RC(GRAVE)
&trans  &kp LEFT_ARROW  &kp UP_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none               &none            &trans  &trans  &trans  &trans    &none      &none                &kp F5        &kp F6        &kp F7        &kp F8        &trans
&trans  &none           &none         &none           &none            &none               &none            &trans  &trans  &trans  &trans    &none      &none                &kp F9        &kp F10       &kp F11       &kp F12       &studio_unlock
&trans  &none                         &none           &kp SPACE        &kp LG(LEFT_ARROW)  &kp BACKSPACE                                      &kp ENTER  &kp RG(RIGHT_ARROW)                                                          &trans
            >;
        };

        adjust_layer {
            display-name = "ADJUST";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans  &trans  &trans  &trans                                      &trans  &trans                                  &trans
            >;
        };

        // Extra layer can be added in ZMK STUDIO

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
