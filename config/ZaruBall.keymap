//#include <dt-bindings/zmk/mouse.h>

#include <behaviors/rgbled_widget.dtsi>
#include <behaviors/naginata.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE     0
#define MOUSE    1
#define LOWER    2
#define RAISE    3
#define NUM      4
#define SCR_V    5      // ← scr_v_layer
#define SCR_H    6      // ← scr_h_layer
#define ADJUST   7

// スクロール量の設定
// #define ZMK_POINTING_DEFAULT_SCRL_VAL 100

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <LOWER RAISE>;   // ← 数値の代わりにマクロでOK
            then-layer = <ADJUST>;       // ← 4 → ADJUST(=7)
        };
    };
};

/ {
    behaviors {
        // スクロール用のbehaviorの設定

        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        // 方向が逆だと思ったら、下の別定義を有効化して置き換えればOK
        // scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
        //     compatible = "zmk,behavior-sensor-rotate";
        //     #sensor-binding-cells = <0>;
        //     bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>; // ↑と↓を反転
        //     tap-ms = <20>;
        // };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo RAISE>, <&mo MOUSE>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo RAISE>, <&mo MOUSE>;
        };

        // Customed Hold-Tap for SandS

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <500>;
            quick-tap-ms = <500>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };

        /* ===== 追加: “押下直後に必ずBASEへ(to0)” 版の Behaviors（前回の6種） ===== */

        /* A) tap=LANG1 / hold=RIGHT_GUI */
        to0_ht_rgui_lang1: to0_ht_rgui_lang1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-while-undecided;
            bindings = <&to0_hold_rgui>, <&to0_tap_lang1>;
        };

        /* B) tap=LANG2 / hold=LEFT_ALT */
        to0_ht_lalt_lang2: to0_ht_lalt_lang2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-while-undecided;
            bindings = <&to0_hold_lalt>, <&to0_tap_lang2>;
        };

        /* C) tap=LEFT_GUI + C / hold=LEFT_CONTROL */
        to0_ht_lctl_lguic: to0_ht_lctl_lguic {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-while-undecided;
            bindings = <&to0_hold_lctl>, <&to0_tap_lgui_c>;
        };

        /* D) tap=RIGHT_GUI + V / hold=RIGHT_CONTROL */
        to0_ht_rctl_rguiv: to0_ht_rctl_rguiv {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-while-undecided;
            bindings = <&to0_hold_rctl>, <&to0_tap_rgui_v>;
        };

        /* LT(自作) その1: tap=[ , hold中は Layer 6 */
        to0_lt6_lbkt: to0_lt6_lbkt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-while-undecided;
            bindings = <&to0_hold_mo6>, <&to0_tap_lbkt>;
        };

        /* LT(自作) その2: tap=] , hold中は Layer 5 */
        to0_lt5_rbkt: to0_lt5_rbkt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-while-undecided;
            bindings = <&to0_hold_mo5>, <&to0_tap_rbkt>;
        };

        /* ===== 追加: “押下直後に必ずBASEへ(to0)” 版の Behaviors（今回の6種） ===== */

        /* tap=U / hold=MSC: scroll down */
        to0_ht_scrld_u: to0_ht_scrld_u {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-while-undecided;
            bindings = <&to0_hold_scrld>, <&to0_tap_u>;
        };

        /* tap=I / hold=MSC: scroll up */
        to0_ht_scrlu_i: to0_ht_scrlu_i {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-while-undecided;
            bindings = <&to0_hold_scrlu>, <&to0_tap_i>;
        };

        /* tap=R / hold=MSC: scroll right */
        to0_ht_scrlr_r: to0_ht_scrlr_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-while-undecided;
            bindings = <&to0_hold_scrlr>, <&to0_tap_r>;
        };

        /* tap=E / hold=MSC: scroll left */
        to0_ht_scrll_e: to0_ht_scrll_e {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-while-undecided;
            bindings = <&to0_hold_scrll>, <&to0_tap_e>;
        };

        /* LT相当：tap=Left GUI+V / hold中だけ Layer 3 */
        to0_lt3_lgui_v: to0_lt3_lgui_v {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-while-undecided;
            bindings = <&to0_hold_mo3>, <&to0_tap_lgui_v>;
        };

        /* LT相当：tap=Left Alt+Up / hold中だけ Layer 2 */
        to0_lt2_lalt_up: to0_lt2_lalt_up {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-while-undecided;
            bindings = <&to0_hold_mo2>, <&to0_tap_lalt_up>;
        };

        /* ===== 追加: to0無し（シンプル）版の Behaviors（今回の4種） ===== */

        /* tap=U / hold=MSC: scroll down */
        ht_scrld_u: ht_scrld_u {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&hold_scrld>, <&tap_u>;
        };

        /* tap=I / hold=MSC: scroll up */
        ht_scrlu_i: ht_scrlu_i {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&hold_scrlu>, <&tap_i>;
        };

        /* tap=R / hold=MSC: scroll right */
        ht_scrlr_r: ht_scrlr_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&hold_scrlr>, <&tap_r>;
        };

        /* tap=E / hold=MSC: scroll left */
        ht_scrll_e: ht_scrll_e {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&hold_scrll>, <&tap_e>;
        };
    };
};

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog MOUSE &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        // When LCLK pressed, exit AML (after 250ms cause by sticky layer

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl MOUSE>;

            label = "MKP_EXIT_AML";
        };

        cmd_click: cmd_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_wait_time 25>,
                <&mkp LCLK>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_wait_time 5>,
                <&mkp LCLK>,
                <&macro_wait_time 15>,
                <&kp LEFT_GUI>,
                <&macro_tap>,
                <&sl MOUSE>;

            label = "CMD_CLICK";
        };

        /* ===== 追加: “押下直後に必ずBASEへ(to0)” 版の Macros（前回の6種の部品） ===== */

        /* ---- HOLD 側（修飾押しっぱなし） ---- */
        to0_hold_rgui: to0_hold_rgui {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&kp RIGHT_GUI>,
                <&macro_pause_for_release>,
                <&macro_release>;
        };

        to0_hold_lalt: to0_hold_lalt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_pause_for_release>,
                <&macro_release>;
        };

        to0_hold_lctl: to0_hold_lctl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_pause_for_release>,
                <&macro_release>;
        };

        to0_hold_rctl: to0_hold_rctl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&kp RIGHT_CONTROL>,
                <&macro_pause_for_release>,
                <&macro_release>;
        };

        /* ---- TAP 側（単発動作） ---- */
        to0_tap_lang1: to0_tap_lang1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&kp LANG1>;
        };

        to0_tap_lang2: to0_tap_lang2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&kp LANG2>;
        };

        /* tap: Left GUI + C */
        to0_tap_lgui_c: to0_tap_lgui_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&kp C>,
                <&macro_release>;
        };

        /* tap: Right GUI + V */
        to0_tap_rgui_v: to0_tap_rgui_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&kp RIGHT_GUI>,
                <&kp V>,
                <&macro_release>;
        };

        /* ---- LT 用：hold中にレイヤーを維持（&mo を押しっぱなし） ---- */
        to0_hold_mo6: to0_hold_mo6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&mo 6>,
                <&macro_pause_for_release>,
                <&macro_release>;
        };

        to0_tap_lbkt: to0_tap_lbkt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&kp LEFT_BRACKET>;
        };

        to0_hold_mo5: to0_hold_mo5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&mo 5>,
                <&macro_pause_for_release>,
                <&macro_release>;
        };

        to0_tap_rbkt: to0_tap_rbkt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&kp RIGHT_BRACKET>;
        };

        /* ===== 追加: “押下直後に必ずBASEへ(to0)” 版の Macros（今回の6種の部品） ===== */

        /* ── Hold側：スクロール（押している間だけ） ── */
        to0_hold_scrld: to0_hold_scrld {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_press>, <&msc SCRL_DOWN>,  <&macro_pause_for_release>, <&macro_release>;
        };
        to0_hold_scrlu: to0_hold_scrlu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_press>, <&msc SCRL_UP>,    <&macro_pause_for_release>, <&macro_release>;
        };
        to0_hold_scrlr: to0_hold_scrlr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_press>, <&msc SCRL_RIGHT>, <&macro_pause_for_release>, <&macro_release>;
        };
        to0_hold_scrll: to0_hold_scrll {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_press>, <&msc SCRL_LEFT>,  <&macro_pause_for_release>, <&macro_release>;
        };

        /* ── Tap側（単発キーやコンボ） ── */
        to0_tap_u: to0_tap_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&kp U>;
        };
        to0_tap_i: to0_tap_i {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&kp I>;
        };
        to0_tap_r: to0_tap_r {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&kp R>;
        };
        to0_tap_e: to0_tap_e {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&kp E>;
        };

        /* ── LT相当（holdでレイヤー維持 / tapでコンボ） ── */
        to0_hold_mo3: to0_hold_mo3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_press>, <&mo 3>, <&macro_pause_for_release>, <&macro_release>;
        };
        to0_tap_lgui_v: to0_tap_lgui_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_press>, <&kp LEFT_GUI>, <&kp V>, <&macro_release>;
        };

        to0_hold_mo2: to0_hold_mo2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_press>, <&mo 2>, <&macro_pause_for_release>, <&macro_release>;
        };
        to0_tap_lalt_up: to0_tap_lalt_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0>, <&macro_press>, <&kp LEFT_ALT>, <&kp UP_ARROW>, <&macro_release>;
        };

        /* ===== 追加: to0無し（シンプル）版の Macros（今回の4種の部品） ===== */

        /* ── Hold側（スクロール） ── */
        hold_scrld: hold_scrld {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&msc SCRL_DOWN>,  <&macro_pause_for_release>, <&macro_release>;
        };
        hold_scrlu: hold_scrlu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&msc SCRL_UP>,    <&macro_pause_for_release>, <&macro_release>;
        };
        hold_scrlr: hold_scrlr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&msc SCRL_RIGHT>, <&macro_pause_for_release>, <&macro_release>;
        };
        hold_scrll: hold_scrll {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&msc SCRL_LEFT>,  <&macro_pause_for_release>, <&macro_release>;
        };

        /* ── Tap側（単発キー） ── */
        tap_u: tap_u { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp U>; };
        tap_i: tap_i { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp I>; };
        tap_r: tap_r { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp R>; };
        tap_e: tap_e { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp E>; };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&inc_dec_kp LA(LEFT_ARROW) LA(RIGHT_ARROW)>;
            bindings = <
&kp ESC                 &kp N1      &kp N2  &kp N3            &kp N4             &kp N5                                                       &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                             &kp NUMBER_6         &kp N7  &kp N8     &kp N9   &kp N0    &kp EQUAL
&kp TAB                 &kp Q       &kp W   &kp E             &kp R              &kp T                                                        &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                           &kp Y                &kp U   &kp I      &kp O    &kp P     &kp MINUS
&kp BACKSPACE           &kp A       &kp S   &kp D             &kp F              &kp G               &mt LG(LS(NUMBER_4)) LG(LS(NUMBER_5))    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &kp UP_ARROW           &kp H                &kp J   &kp K      &kp L    &kp SEMI  &kp ENTER
&kp LEFT_ARROW          &kp Z       &kp X   &kp C             &kp V              &kp B               &kp LA(UP_ARROW)
