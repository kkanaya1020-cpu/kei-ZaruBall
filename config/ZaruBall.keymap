//#include <dt-bindings/zmk/mouse.h>

#include <behaviors/rgbled_widget.dtsi>
#include <behaviors/naginata.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE     0
#define MOUSE    1
#define LOWER    2
#define RAISE    3
#define NUM      4
#define SCR_V    5      // ← scr_v_layer
#define SCR_H    6      // ← scr_h_layer
#define ADJUST   7

// スクロール量の設定
// #define ZMK_POINTING_DEFAULT_SCRL_VAL 100

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <LOWER RAISE>;   // ← 数値の代わりにマクロでOK
            then-layer = <ADJUST>;       // ← 4 → ADJUST(=7)
        };
    };
};

/ {
    behaviors {
        // スクロール用のbehaviorの設定

        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        // 方向が逆だと思ったら、下の別定義を有効化して置き換えればOK
        // scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
        //     compatible = "zmk,behavior-sensor-rotate";
        //     #sensor-binding-cells = <0>;
        //     bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>; // ↑と↓を反転
        //     tap-ms = <20>;
        // };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo RAISE>, <&mo MOUSE>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo RAISE>, <&mo MOUSE>;
        };

        // Customed Hold-Tap for SandS

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <500>;
            quick-tap-ms = <500>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };

        /* ===== 追加: “押下直後に必ずBASEへ(to0)” 版の Behaviors（最初の6種） ===== */
        /* A) tap=LANG1 / hold=RIGHT_GUI */

        to0_ht_rgui_lang1: to0_ht_rgui_lang1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-while-undecided;
            bindings = <&to0_hold_rgui>, <&to0_tap_lang1>;
        };

        /* B) tap=LANG2 / hold=LEFT_ALT */

        to0_ht_lalt_lang2: to0_ht_lalt_lang2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-while-undecided;
            bindings = <&to0_hold_lalt>, <&to0_tap_lang2>;
        };

        /* C) tap=LEFT_GUI + C / hold=LEFT_CONTROL */

        to0_ht_lctl_lguic: to0_ht_lctl_lguic {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-while-undecided;
            bindings = <&to0_hold_lctl>, <&to0_tap_lgui_c>;
        };

        /* D) tap=RIGHT_GUI + V / hold=RIGHT_CONTROL */

        to0_ht_rctl_rguiv: to0_ht_rctl_rguiv {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-while-undecided;
            bindings = <&to0_hold_rctl>, <&to0_tap_rgui_v>;
        };

        /* LT(自作) その1: tap=[ , hold中は Layer 6 */

        to0_lt6_lbkt: to0_lt6_lbkt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-while-undecided;
            bindings = <&to0_hold_mo6>, <&to0_tap_lbkt>;
        };

        /* LT(自作) その2: tap=] , hold中は Layer 5 */

        to0_lt5_rbkt: to0_lt5_rbkt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-while-undecided;
            bindings = <&to0_hold_mo5>, <&to0_tap_rbkt>;
        };

        /* ===== 追加: “押下直後に必ずBASEへ(to0)” 版の Behaviors（LT 2種：今回追加） ===== */
        /* LT相当：tap=Left GUI+V / hold中だけ Layer 3 */

        to0_lt3_lgui_v: to0_lt3_lgui_v {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-while-undecided;
            bindings = <&to0_hold_mo3>, <&to0_tap_lgui_v>;
        };

        /* LT相当：tap=Left Alt+Up / hold中だけ Layer 2 */

        to0_lt2_lalt_up: to0_lt2_lalt_up {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-while-undecided;
            bindings = <&to0_hold_mo2>, <&to0_tap_lalt_up>;
        };

        to0_ht_rshift_space: to0_ht_rshift_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-while-undecided;
            label = "TO0_HT_RSHIFT_SPACE";
            bindings = <&to0_hold_shift>, <&to0_tap_space>;
        };
    };
};

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog MOUSE &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        // When LCLK pressed, exit AML (after 250ms cause by sticky layer

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl MOUSE>;

            label = "MKP_EXIT_AML";
        };

        cmd_click: cmd_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI>,
                <&macro_wait_time 25>,
                <&mkp LCLK>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_wait_time 5>,
                <&mkp LCLK>,
                <&macro_wait_time 15>,
                <&kp LEFT_GUI>,
                <&macro_tap>,
                <&sl MOUSE>;

            label = "CMD_CLICK";
        };

        /* ===== 追加: “押下直後に必ずBASEへ(to0)” 版の Macros（最初の6種の部品） ===== */
        /* ---- HOLD 側（修飾押しっぱなし） ---- */

        to0_hold_rgui: to0_hold_rgui {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&kp RIGHT_GUI>,
                <&macro_pause_for_release>,
                <&macro_release>;
        };

        to0_hold_lalt: to0_hold_lalt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_pause_for_release>,
                <&macro_release>;
        };

        to0_hold_lctl: to0_hold_lctl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_pause_for_release>,
                <&macro_release>;
        };

        to0_hold_rctl: to0_hold_rctl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&kp RIGHT_CONTROL>,
                <&macro_pause_for_release>,
                <&macro_release>;
        };

        /* ---- TAP 側（単発動作） ---- */

        to0_tap_lang1: to0_tap_lang1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LANG1>;
        };

        to0_tap_lang2: to0_tap_lang2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LANG2>;
        };

        /* tap: Left GUI + C */

        to0_tap_lgui_c: to0_tap_lgui_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&kp LEFT_GUI &kp C>,
                <&macro_release>;
        };

        /* tap: Right GUI + V */

        to0_tap_rgui_v: to0_tap_rgui_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&kp RIGHT_GUI &kp V>,
                <&macro_release>;
        };

        /* ---- LT 用：hold中にレイヤーを維持（&mo を押しっぱなし） ---- */

        to0_hold_mo6: to0_hold_mo6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&mo 6>,
                <&macro_pause_for_release>,
                <&macro_release>;
        };

        to0_tap_lbkt: to0_tap_lbkt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp LEFT_BRACKET>;
        };

        to0_hold_mo5: to0_hold_mo5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&mo 5>,
                <&macro_pause_for_release>,
                <&macro_release>;
        };

        to0_tap_rbkt: to0_tap_rbkt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp RIGHT_BRACKET>;
        };

        /* ===== 追加: “押下直後に必ずBASEへ(to0)” 版の Macros（LT 2種：今回追加の部品） ===== */
        /* hold: Layer 3 を押しっぱなし（離したら解除） */

        to0_hold_mo3: to0_hold_mo3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&mo 3>,
                <&macro_pause_for_release>,
                <&macro_release>;
        };

        /* tap: Left GUI + V（BASEに戻してから送出） */

        to0_tap_lgui_v: to0_tap_lgui_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&kp LEFT_GUI &kp V>,
                <&macro_release>;
        };

        /* hold: Layer 2 を押しっぱなし（離したら解除） */

        to0_hold_mo2: to0_hold_mo2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&mo 2>,
                <&macro_pause_for_release>,
                <&macro_release>;
        };

        /* tap: Left Alt + Up（BASEに戻してから送出） */

        to0_tap_lalt_up: to0_tap_lalt_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&kp LEFT_ALT &kp UP_ARROW>,
                <&macro_release>;
        };

        to0_tap_space: to0_tap_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &kp SPACE>;
            label = "TO0_TAP_SPACE";
        };

        to0_hold_shift: to0_hold_shift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&kp RIGHT_SHIFT>,
                <&macro_pause_for_release>,
                <&macro_release>;

            label = "TO0_HOLD_SHIFT";
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&inc_dec_kp LA(LEFT_ARROW) LA(RIGHT_ARROW)>;
            bindings = <
&kp ESC                 &kp N1      &kp N2  &kp N3              &kp N4               &kp N5                                                       &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                             &kp NUMBER_6         &kp N7  &kp N8     &kp N9   &kp N0    &kp EQUAL
&kp TAB                 &kp Q       &kp W   &kp E               &kp R                &kp T                                                        &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                           &kp Y                &kp U   &kp I      &kp O    &kp P     &kp MINUS
&kp BACKSPACE           &kp A       &kp S   &kp D               &kp F                &kp G               &mt LG(LS(NUMBER_4)) LG(LS(NUMBER_5))    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &kp UP_ARROW           &kp H                &kp J   &kp K      &kp L    &kp SEMI  &kp ENTER
&kp LEFT_ARROW          &kp Z       &kp X   &kp C               &kp V                &kp B               &lt 2 LA(UP_ARROW)                       &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp DOWN_ARROW         &kp N                &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_ARROW
&mt LEFT_CONTROL LG(C)  &kp C_MUTE          &lt 6 LEFT_BRACKET  &lt 5 RIGHT_BRACKET  &mt LEFT_ALT LANG2  &mt LEFT_SHIFT SPACE                                                                             &mt RIGHT_SHIFT SPACE  &mt RIGHT_GUI LANG1                                        &lt 3 RG(V)
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&to_layer_0 ESCAPE      &to_layer_0 N1  &to_layer_0 N2  &to_layer_0 N3      &to_layer_0 N4      &to_layer_0 N5                                      &trans  &trans  &trans  &trans                              &to_layer_0 N6          &to_layer_0 N7      &to_layer_0 N8      &to_layer_0 N9      &to_layer_0 N0         &to_layer_0 EQUAL
&to_layer_0 TAB         &to_layer_0 Q   &to_layer_0 W   &to_layer_0 E       &to_layer_0 R       &to_layer_0 T                                       &trans  &trans  &trans  &trans                              &to_layer_0 Y           &to_layer_0 U       &to_layer_0 I       &to_layer_0 O       &to_layer_0 P          &to_layer_0 MINUS
&to_layer_0 BACKSPACE   &to_layer_0 A   &cmd_click      &mkp_exit_AML RCLK  &mkp_exit_AML LCLK  &to_layer_0 G           &trans                      &trans  &trans  &trans  &trans    &to_layer_0 UP_ARROW      &to_layer_0 H           &mkp_exit_AML LCLK  &mkp_exit_AML RCLK  &cmd_click          &to_layer_0 SEMICOLON  &to_layer_0 ENTER
&to_layer_0 LEFT_ARROW  &to_layer_0 Z   &to_layer_0 X   &to_layer_0 C       &to_layer_0 V       &to_layer_0 B           &to0_lt2_lalt_up 0 0        &trans  &trans  &trans  &trans    &to_layer_0 DOWN_ARROW    &to_layer_0 N           &to_layer_0 M       &to_layer_0 COMMA   &to_layer_0 PERIOD  &to_layer_0 SLASH      &to_layer_0 RIGHT_ARROW
&to0_ht_lctl_lguic 0 0  &trans                          &to0_lt6_lbkt 0 0   &to0_lt5_rbkt 0 0   &to0_ht_lalt_lang2 0 0  &to0_ht_rshift_space 0 0                                      &to0_ht_rshift_space 0 0  &to0_ht_rgui_lang1 0 0                                                                                     &to0_lt3_lgui_v 0 0
            >;
        };

        Fn_layer {
            display-name = "Fn";
            sensor-bindings = <&inc_dec_kp F14 F15>;
            bindings = <
&trans  &none           &none         &none           &none            &none            &trans  &trans  &trans  &trans                          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR_ALL
&trans  &none           &none         &none           &none            &none            &trans  &trans  &trans  &trans                          &none         &kp F1        &kp F2        &kp F3        &kp F4        &kp RC(GRAVE)
&trans  &kp LEFT_ARROW  &kp UP_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none  &trans    &trans  &trans  &trans  &trans    &kp RG(RS(NUMBER_5))  &none         &kp F5        &kp F6        &kp F7        &kp F8        &trans
&trans  &none           &none         &none           &none            &none  &none     &trans  &trans  &trans  &trans    &kp RG(RS(NUMBER_4))  &none         &kp F9        &kp F10       &kp F11       &kp F12       &studio_unlock
&trans  &none                         &trans          &none            &none  &none                                       &none                 &trans                                                                &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            sensor-bindings = <&inc_dec_kp LC(LEFT_ARROW) LC(RIGHT_ARROW)>;
            bindings = <
&trans  &kp LG(LEFT_ARROW)      &kp LG(UP_ARROW)      &kp LG(DOWN_ARROW)      &kp LG(RIGHT_ARROW)      &none                                 &trans  &trans  &trans  &trans            &none                &none      &none      &none  &none  &none
&trans  &kp LS(LEFT)            &kp LS(UP_ARROW)      &kp LS(DOWN_ARROW)      &kp LS(RIGHT)            &none                                 &trans  &trans  &trans  &trans            &none                &none      &none      &none  &none  &none
&trans  &kp LEFT_ARROW          &kp UP_ARROW          &kp DOWN_ARROW          &kp RIGHT_ARROW          &none         &none                   &trans  &trans  &trans  &trans    &none   &none                &mkp LCLK  &mkp RCLK  &none  &none  &none
&trans  &kp LS(LG(LEFT_ARROW))  &kp LS(LG(UP_ARROW))  &kp LS(LG(DOWN_ARROW))  &kp LS(LG(RIGHT_ARROW))  &none         &kp LA(LG(UP_ARROW))    &trans  &trans  &trans  &trans    &none   &none                &kp HOME   &kp END    &none  &none  &none
&trans  &none                                         &trans                  &trans                   &kp LG(LEFT)  &trans                                                    &trans  &kp RG(RIGHT_ARROW)                                      &trans
            >;
        };

        number_layer {
            display-name = "number";
            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
            bindings = <
&trans  &none       &none  &none   &none   &none             &trans  &trans  &trans  &trans              &none         &none            &none            &none            &none            &none
&trans  &none       &none  &none   &none   &none             &trans  &trans  &trans  &trans              &kp PLUS      &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_4  &kp KP_NUMBER_5
&trans  &none       &none  &none   &none   &none   &none     &trans  &trans  &trans  &trans    &kp HOME  &kp KP_MINUS  &kp KP_NUMBER_6  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMBER_0
&trans  &none       &none  &none   &none   &none   &none     &trans  &trans  &trans  &trans    &kp END   &kp ASTERISK  &kp SLASH        &kp COMMA        &kp PERIOD       &none            &none
&trans  &kp C_MUTE         &trans  &trans  &trans  &trans                                      &trans    &kp EQUAL                                                                         &trans
            >;
        };

        scr_v_layer {
            display-name = "SCR_V";
            bindings = <
&trans      &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans  &trans             &trans       &trans         &trans
&trans      &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans  &kp RS(BACKSLASH)  &trans       &trans         &kp RS(GRAVE)
&kp DELETE  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans             &trans       &kp GRAVE      &kp RG(ENTER)
&trans      &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans  &kp SQT            &kp RS(SQT)  &kp BACKSLASH  &trans
&trans      &trans          &trans  &trans  &trans  &trans                                      &trans  &trans                                                         &trans
            >;

            sensor-bindings = <&inc_dec_kp F14 F15>;
        };

        scr_h_layer {
            display-name = "SCR_H";
            bindings = <
&trans      &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans  &trans             &trans       &trans         &trans
&trans      &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans  &kp RS(BACKSLASH)  &trans       &trans         &kp RS(GRAVE)
&kp DELETE  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans             &trans       &kp GRAVE      &kp RG(ENTER)
&trans      &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans  &kp SQT            &kp RS(SQT)  &kp BACKSLASH  &trans
&trans      &trans          &trans  &trans  &trans  &trans                                      &trans  &trans                                                         &trans
            >;
        };

        adjust_layer {
            display-name = "ADJUST";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans  &trans  &trans  &trans                                      &trans  &trans                                  &trans
            >;
        };

        // Extra layer can be added in ZMK STUDIO

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
